# Pooled Neon URL for the application, or a local PostgreSQL connection URL.
# For Neon, use sslmode=verify-full and keep other connection parameters.
DATABASE_URL=
# Optional direct Neon URL for Prisma migrations.
DIRECT_URL=
# Required only by the local Docker Compose database service.
POSTGRES_PASSWORD=

# Generate a separate random value with: openssl rand -hex 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Redis TCP/TLS endpoint for coordination locks, short-lived hints and rate limits.
REDIS_URL=
# Optional separate Redis service for the workspace catalog cache.
REDIS_CACHE_URL=
# Optional label per running app instance. A unique label is generated when blank.
APP_INSTANCE_ID=

# Maximum duration of a hold in seconds. A slot’s start time may shorten it.
RESERVATION_TTL_SECONDS=300

# Keep Easebuzz merchant credentials on the server.
EB_MERCHANT_KEY=
EB_SALT=
EB_ENV=test
APP_EB_MODE=test
EB_LINK=https://testpay.easebuzz.in/payment/initiateLink
